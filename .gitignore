# Python
__pycache__/
*.egg-info/
venv/

# 配置：config/ 下只提交默认值和示例；实例配置（含密钥、数据库密码）、TUI 配置、心跳提示词不提交
config/config.local.yaml
config/cli.yaml
config/heartbeat.md
# 本项目已不用 .env 存密钥，仍忽略它以防误提交密钥
.env

# 运行数据与日志
data/
logs/
# QQ 渠道（botpy SDK）运行时在当前目录写的日志
botpy.log
# start-team.sh 的 team 模式实例目录（config/ 里有密钥和数据库密码，data/ 是运行数据）
instances/

# 网页前端
admin/node_modules/
admin/dist/

# 文档：只提交 docs/eventbus.md，其余设计与计划文档留在本地
docs/*
!docs/eventbus.md

# 个人部署脚本
deploy.sh

# 编辑器与系统文件
.idea/
.DS_Store

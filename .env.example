# LLM
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Google Calendar (optional — mock fallback if not set)
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_ID=primary

# ChromaDB
CHROMA_PERSIST_DIR=data/chroma

# Data
DATA_DIR=data

# Context Management (compresses when context > model_max * threshold)
POLARIS_MODEL_MAX_CONTEXT=200000
POLARIS_COMPRESSION_THRESHOLD=0.8

# Feishu / Lark Bot (optional)
FEISHU_APP_ID=cli_...
FEISHU_APP_SECRET=...

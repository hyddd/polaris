# Polaris 本地覆盖配置示例
# 复制此文件为 config.local.yaml 并填写真实密钥。
# config.local.yaml 已被 gitignore，不会提交到版本库。

llm:
  api_key: "sk-your-key-here"
  base_url: "https://api.openai.com/v1"
  model: "gpt-4o"

embedding:
  api_key: ""
  base_url: ""
  model: "netease-youdao/bce-embedding-base_v1"

channels:
  feishu:
    enabled: false
    app_id: ""
    app_secret: ""
  qq:
    enabled: false
    bot_appid: ""
    bot_secret: ""

tools:
  calendar: {}
  web_search:
    api_key: ""

server:
  admin_token: ""
  max_sessions: 10
  rate_limit_max_requests: 30

# 心跳定时任务（可选）
# heartbeat:
#   enabled: true
#   interval_minutes: 60
#   channel: "feishu"
#   prompt_file: "data/heartbeat.md"
